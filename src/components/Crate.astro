---
import type { CollectionEntry } from 'astro:content';
import Cartridge from './Cartridge.astro';
import { spineVar } from '../lib/spine';

interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const n = String(projects.length).padStart(2, '0');
---
<section class="crate-view container" data-show="full" aria-labelledby="crate-h">
  <div class="intro">
    <h1 id="crate-h" class="h-display">Dig through my crate</h1>
    <p class="prompt">Every project I've shipped or prototyped, filed like records.</p>
    <p class="body-sm muted"><span class="hint-mouse">Hover a cartridge to pull it up, click to open it. ← → work too.</span><span class="hint-touch">Tap a cartridge to pull it up, tap it again to open it.</span></p>
  </div>

  <div class="crate" data-crate tabindex="0" role="group" aria-roledescription="carousel" aria-label="Projects crate" style={`--n:${projects.length}`}>
    <p class="visually-hidden" aria-live="polite" data-crate-live></p>
    <div class="world">
      {projects.map((p, i) => (
        <a class="cart" href={`/work/${p.id}`} data-cart data-title={p.data.title} style={`--i:${i};--spine:${spineVar(p.data.spine)}`} aria-label={`${String(i + 1).padStart(2, '0')} ${p.data.title}`} tabindex="-1">
          <span class="face front"><Cartridge title={p.data.title} spine={p.data.spine} cover={p.data.cover} youtubeId={p.data.videos[0]?.youtubeId} caption={`${p.data.status.split(' ')[0]} · ${p.data.engine.split(' ')[0]}`} /></span>
          <span class="face top" aria-hidden="true"></span>
          <span class="face side" aria-hidden="true"></span>
        </a>
      ))}
      <div class="box" aria-hidden="true">
        <div class="wall back"></div>
        <div class="wall side"></div>
        <div class="wall front"><span class="label">Crate 01 · {projects.length} cartridges</span></div>
      </div>
    </div>
  </div>

  <div class="cards">
    {projects.map((p, i) => (
      <article class="panel card" data-crate-card hidden={i !== 0} style={`--spine:${spineVar(p.data.spine)}`}>
        <header class="panel-header label"><span>{String(i + 1).padStart(2, '0')} / {n} · Now flipped to</span></header>
        <div class="card-body">
          <h2 class="h-md">{p.data.title}</h2>
          <p class="body-sm">{p.data.genre} · {p.data.engine.split(' · ')[0]} · {p.data.platform.split(' · ')[0]}</p>
          <p class="role prompt">{p.data.role}</p>
          <p class="prompt">{p.data.oneLine}</p>
          <div class="actions">
            <a class="btn btn-primary" href={`/work/${p.id}`}>▶ Pull out</a>
            <a class="btn btn-ghost-paper" href="#projects" data-to-quick>List view</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { initCrate } from '../scripts/crate';
  const root = document.querySelector<HTMLElement>('[data-crate]');
  if (root) initCrate(root);
</script>

<style>
  :global(html[data-mode="full"]) .crate-view { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr) minmax(320px, 3fr); gap: var(--spacing-xl); align-items: center; min-height: calc(100vh - 120px); padding-block: var(--spacing-2xl); }
  .intro .h-display { font-size: 72px; }
  .hint-touch { display: none; }
  @media (hover: none) { .hint-mouse { display: none; } .hint-touch { display: inline; } }
  .intro .prompt { margin-top: var(--spacing-lg); max-width: 40ch; }

  /* Isometric crate built from CSS 3D planes. x right, y down, z toward the viewer;
     cartridge i stands at z = -i * pitch, so the crate recedes back-right. */
  .crate { --w: 220px; --h: 330px; --d: 28px; --pitch: 44px; --wall: 150px; --pad: 14px;
    --depth: calc((var(--n) - 1) * var(--pitch) + var(--d) + 2 * var(--pad));
    position: relative; height: 560px; perspective: 1600px; display: grid; place-items: center; outline-offset: 8px; }
  .world { position: relative; width: var(--w); height: var(--h); transform-style: preserve-3d;
    transform: translate(-70px, 60px) scale(1.1) rotateX(-16deg) rotateY(-42deg); }
  .face, .wall { position: absolute; display: block; }

  .cart { position: absolute; inset: 0; transform-style: preserve-3d; color: inherit; text-decoration: none;
    transform: translateZ(calc(var(--i) * var(--pitch) * -1)); transition: transform 260ms cubic-bezier(.2, .7, .2, 1); }
  .cart[data-active] { transform: translateZ(calc(var(--i) * var(--pitch) * -1)) translateY(-120px) rotateX(6deg); }
  .cart:focus-visible { outline: none; }
  .cart:focus-visible .front { outline: 2px solid var(--color-primary-bright); outline-offset: 4px; }
  .front { inset: 0; transform: translateZ(calc(var(--d) / 2)); }
  /* Faces overlap the front by 1px so no hairline gap shows at the edges. */
  .top { left: 0; top: 0; width: var(--w); height: calc(var(--d) + 1px); transform-origin: top; transform: translateZ(calc(var(--d) / 2 + 1px)) rotateX(-90deg);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--spine) 85%, white), var(--spine) 40%, color-mix(in srgb, var(--spine) 70%, var(--color-ink))); }
  .cart .side { top: 0; left: calc(var(--w) - 1px); width: calc(var(--d) + 1px); height: var(--h); transform-origin: left; transform: translateZ(calc(var(--d) / 2 + 1px)) rotateY(90deg);
    background: linear-gradient(to right, color-mix(in srgb, var(--color-surface-raised) 70%, var(--color-ink)), color-mix(in srgb, var(--color-surface-raised) 45%, var(--color-ink)));
    box-shadow: inset 0 6px 0 var(--spine); }

  .box { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; }
  .wall { top: calc(var(--h) - var(--wall) + 20px); height: var(--wall); }
  .wall.front, .wall.back { left: calc(var(--pad) * -1); width: calc(var(--w) + 2 * var(--pad)); }
  .wall.front { transform: translateZ(calc(var(--d) / 2 + var(--pad))); background: var(--color-surface-raised); border-radius: var(--rounded-md); box-shadow: var(--shadow-paper);
    display: flex; align-items: end; padding: var(--spacing-lg);
    background-image: repeating-linear-gradient(to bottom, var(--color-border) 0 1px, transparent 1px 4px); background-size: 80% 12px; background-position: 50% 18px; background-repeat: no-repeat; }
  .wall.front .label { color: var(--color-on-surface-muted); }
  .wall.back { transform: translateZ(calc(var(--d) / 2 + var(--pad) - var(--depth))); background: color-mix(in srgb, var(--color-surface-raised) 50%, var(--color-ink)); }
  .wall.side { left: calc(var(--w) + var(--pad)); width: var(--depth); transform-origin: left;
    transform: translateZ(calc(var(--d) / 2 + var(--pad))) rotateY(90deg); background: color-mix(in srgb, var(--color-surface-raised) 70%, var(--color-ink)); }

  .card-body { padding: var(--spacing-lg); display: grid; gap: var(--spacing-sm); }
  .card-body p { margin: 0; }
  .role { color: var(--color-primary); }
  .actions { display: flex; gap: var(--spacing-sm); flex-wrap: wrap; margin-top: var(--spacing-md); }
  @media (max-width: 1199px) { :global(html[data-mode="full"]) .crate-view { grid-template-columns: 1fr; } }
  /* Phones: same 3D crate, scaled down; the card sits below it. */
  @media (max-width: 767px) {
    :global(html[data-mode="full"]) .crate-view { min-height: 0; gap: var(--spacing-md); padding-block: var(--spacing-lg) var(--spacing-xl); }
    .intro .h-display { font-size: 52px; }
    .intro .prompt { margin-top: var(--spacing-sm); }
    .crate { height: 380px; overflow-x: clip; }
    .world { transform: translate(-48px, 20px) scale(0.78) rotateX(-16deg) rotateY(-42deg); }
    .card-body { padding: var(--spacing-md); }
  }
</style>
